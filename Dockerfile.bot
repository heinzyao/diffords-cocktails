# 強制 amd64：Cloud Run 執行環境為 x86_64
# 顯式宣告 uv 暫存層 platform，確保從 amd64 映像複製 binary
FROM --platform=linux/amd64 ghcr.io/astral-sh/uv:latest AS uv-binary
FROM --platform=linux/amd64 python:3.12-slim

WORKDIR /app

# 安裝 uv（從 amd64 暫存層複製）
COPY --from=uv-binary /uv /usr/local/bin/uv

# 先複製依賴清單，利用 Docker layer 快取
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen

# 複製程式碼
COPY . .

# Cloud Run 預設注入 PORT=8080
EXPOSE 8080

# gunicorn 而非 Flask 內建 dev server。
# --workers 1 是刻意的：_scrape_state／_scrape_lock（擋重複啟動爬蟲）與 _token_cache
# 都是行程內狀態，多 worker 會各有一份而讓那個鎖失效。要併發就加 threads，
# 執行緒共享記憶體，鎖仍然有效。
# 用 sh -c 是為了讓 Cloud Run 注入的 $PORT 展開。
CMD ["sh", "-c", "uv run gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --threads 8 --timeout 60 --access-logfile - bot:app"]
